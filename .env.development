# Safe local development defaults. Production builds do not load this file.
# Server-only admission proxy settings; never expose these with a VITE_ prefix.
TRUCOSHI_SERVER_URL=http://localhost:2992
TRUCOSHI_OPS_STATUS_TOKEN=trucoshi-dev-ops-status-token

# Public browser settings. Every VITE_ value is bundled into the client.
VITE_APP_ENVIRONMENT=development
VITE_APP_VERSION=$npm_package_version
VITE_APP_NAME=$npm_package_name
VITE_APP_HOST=http://localhost:2992
VITE_LIGHTNING_ACCOUNTS_URL=http://localhost:2999/v1
VITE_LIGHTNING_ACCOUNTS_COOKIE_PREFIX=
VITE_ENABLE_BETS_AND_DEPOSITS=1
VITE_DEBUG=0
